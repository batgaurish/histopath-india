rules_version = '2';

// ═══════════════════════════════════════════════════════════
// HistoPath India — Storage rules
//
// Slides are world-readable, since students browse without an account.
// Only approved staff may upload, and only images, capped at 8 MB.
//
// Paste into: Firebase console → Storage → Rules → Publish
// ═══════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isApprovedStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid))
             .data.status == 'approved';
    }

    match /slides/{missionId} {
      allow read: if true;

      allow write: if isApprovedStaff()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isApprovedStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
